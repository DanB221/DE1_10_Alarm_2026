
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity COMP_tb is
end entity COMP_tb;

architecture Behavioral of COMP_tb is

    --------------------------------------------------------------------
    -- Component declaration
    --------------------------------------------------------------------
    component COMP is
        port (
            CLK  : in  std_logic;
            RST  : in  std_logic;

            SW0  : in  std_logic;
            BTNC : in  std_logic;

            HT   : in  std_logic_vector(5 downto 0);
            MT   : in  std_logic_vector(5 downto 0);
            ST   : in  std_logic_vector(5 downto 0);

            HA   : in  std_logic_vector(5 downto 0);
            MA   : in  std_logic_vector(5 downto 0);
            SA   : in  std_logic_vector(5 downto 0);

            STAV : out std_logic_vector(3 downto 0);
            LED  : out std_logic;
            BUZZ : out std_logic
        );
    end component;

    --------------------------------------------------------------------
    -- Testbench signals
    --------------------------------------------------------------------
    signal CLK  : std_logic := '0';
    signal RST  : std_logic := '0';

    signal SW0  : std_logic := '0';
    signal BTNC : std_logic := '0';

    signal HT   : std_logic_vector(5 downto 0) := (others => '0');
    signal MT   : std_logic_vector(5 downto 0) := (others => '0');
    signal ST   : std_logic_vector(5 downto 0) := (others => '0');

    signal HA   : std_logic_vector(5 downto 0) := (others => '0');
    signal MA   : std_logic_vector(5 downto 0) := (others => '0');
    signal SA   : std_logic_vector(5 downto 0) := (others => '0');

    signal STAV : std_logic_vector(3 downto 0);
    signal LED  : std_logic;
    signal BUZZ : std_logic;

    -- Pomalší TB clock kvôli dlhšiemu realistickému čakaniu
    constant CLK_PERIOD : time := 1 us;

begin

    --------------------------------------------------------------------
    -- DUT instance
    --------------------------------------------------------------------
    uut : COMP
        port map (
            CLK  => CLK,
            RST  => RST,

            SW0  => SW0,
            BTNC => BTNC,

            HT   => HT,
            MT   => MT,
            ST   => ST,

            HA   => HA,
            MA   => MA,
            SA   => SA,

            STAV => STAV,
            LED  => LED,
            BUZZ => BUZZ
        );

    --------------------------------------------------------------------
    -- Clock generation
    --------------------------------------------------------------------
    p_clk : process
    begin
        while true loop
            CLK <= '0';
            wait for CLK_PERIOD / 2;
            CLK <= '1';
            wait for CLK_PERIOD / 2;
        end loop;
    end process;

    --------------------------------------------------------------------
    -- Stimulus
    --------------------------------------------------------------------
    p_stimulus : process
    begin
        ----------------------------------------------------------------
        -- Reset
        ----------------------------------------------------------------
        RST  <= '1';
        SW0  <= '0';
        BTNC <= '0';

        HT <= std_logic_vector(to_unsigned(10, 6));
        MT <= std_logic_vector(to_unsigned(20, 6));
        ST <= std_logic_vector(to_unsigned(30, 6));

        HA <= std_logic_vector(to_unsigned(6, 6));
        MA <= std_logic_vector(to_unsigned(15, 6));
        SA <= std_logic_vector(to_unsigned(45, 6));

        wait for 5 * CLK_PERIOD;
        RST <= '0';
        wait for 2 * CLK_PERIOD;

        assert STAV = "1111"
            report "CHYBA: Po resete a SW0=0 ma byt STAV = 1111"
            severity error;

        assert LED = '0'
            report "CHYBA: Po resete ma byt LED = 0"
            severity error;

        assert BUZZ = '0'
            report "CHYBA: Po resete ma byt BUZZ = 0"
            severity error;

        ----------------------------------------------------------------
        -- Alarm enabled, no match
        ----------------------------------------------------------------
        SW0 <= '1';
        HT  <= std_logic_vector(to_unsigned(7, 6));
        MT  <= std_logic_vector(to_unsigned(15, 6));
        ST  <= std_logic_vector(to_unsigned(45, 6));

        wait for 3 * CLK_PERIOD;

        assert STAV = "1011"
            report "CHYBA: Pri SW0=1 ma byt STAV = 1011"
            severity error;

        assert BUZZ = '0'
            report "CHYBA: Pri nezhode casu ma byt BUZZ = 0"
            severity error;

        ----------------------------------------------------------------
        -- Match time -> alarm activates
        ----------------------------------------------------------------
        HT <= std_logic_vector(to_unsigned(6, 6));
        MT <= std_logic_vector(to_unsigned(15, 6));
        ST <= std_logic_vector(to_unsigned(45, 6));

        wait for 3 * CLK_PERIOD;

        assert BUZZ = '1'
            report "CHYBA: Pri zhode casu ma byt BUZZ = 1"
            severity error;

        assert LED = '0'
            report "CHYBA: Po aktivacii alarmu ma byt LED = 0"
            severity error;

        ----------------------------------------------------------------
        -- BTNC pulse -> snooze starts
        ----------------------------------------------------------------
        BTNC <= '1';
        wait for CLK_PERIOD;
        BTNC <= '0';

        wait for 3 * CLK_PERIOD;

        assert LED = '1'
            report "CHYBA: Po stlaceni BTNC pocas alarmu ma byt LED = 1"
            severity error;

        assert BUZZ = '0'
            report "CHYBA: Po stlaceni BTNC pocas alarmu ma byt BUZZ = 0"
            severity error;

        ----------------------------------------------------------------
        -- Realistic scenario: SW0 off for 1.5 s
        ----------------------------------------------------------------
        SW0 <= '0';
        wait for 1500 ms;

        assert STAV = "1111"
            report "CHYBA: Po vypnuti SW0 ma byt STAV = 1111"
            severity error;

        assert LED = '0'
            report "CHYBA: Po vypnuti SW0 ma byt LED = 0"
            severity error;

        assert BUZZ = '0'
            report "CHYBA: Po vypnuti SW0 ma byt BUZZ = 0"
            severity error;

        ----------------------------------------------------------------
        -- Turn alarm on again after 1.5 s off
        ----------------------------------------------------------------
        SW0 <= '1';
        wait for 3 * CLK_PERIOD;

        assert STAV = "1011"
            report "CHYBA: Po opatovnom zapnuti SW0 ma byt STAV = 1011"
            severity error;

        -- Keďže čas je stále rovnaký ako alarm, v tvojej logike sa BUZZ znova aktivuje
        assert BUZZ = '1'
            report "CHYBA: Po opatovnom zapnuti SW0 a zhode casu ma byt BUZZ = 1"
            severity error;

        ----------------------------------------------------------------
        -- End simulation
        ----------------------------------------------------------------
        wait for 10 * CLK_PERIOD;

        assert false
            report "SIMULACIA UKONCENA USPESNE"
            severity note;

        wait;
    end process;

end architecture Behavioral;
