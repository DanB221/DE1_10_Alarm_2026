library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity DEB is
    generic (
        C_MAX : positive := 200_000 
    );
    Port ( 
        CLK        : in  STD_LOGIC;
        RST        : in  STD_LOGIC;
        BTNU       : in  STD_LOGIC;
        BTND       : in  STD_LOGIC;
        BTNC       : in  STD_LOGIC;
        BTNU_d     : out STD_LOGIC;
        BTND_d     : out STD_LOGIC;
        BTNC_d     : out STD_LOGIC
    );
end DEB;

architecture Behavioral of DEB is
    ----------------------------------------------------------------
    -- Konštanty (C_MAX odtiaľto zmizla, je v generic)
    ----------------------------------------------------------------
    constant C_SHIFT_LEN : positive := 4;

    ----------------------------------------------------------------
    -- Interné signály
    ----------------------------------------------------------------
    signal ce_sample : std_logic;
    signal btns_in   : std_logic_vector(2 downto 0);
    signal sync0     : std_logic_vector(2 downto 0);
    signal sync1     : std_logic_vector(2 downto 0);
    
    type shift_reg_array is array (0 to 2) of std_logic_vector(C_SHIFT_LEN-1 downto 0);
    signal shift_reg : shift_reg_array;
    
    signal debounced : std_logic_vector(2 downto 0);
    signal delayed   : std_logic_vector(2 downto 0);

    -- Deklarácia komponentu pre clk_en zostáva rovnaká
    component clk_en is
        generic ( G_MAX : positive );
        port (
            CLK : in  std_logic;
            RST : in  std_logic;
            ce  : out std_logic
        );
    end component clk_en;

begin
    btns_in <= BTNU & BTND & BTNC;

    clock_0 : clk_en
        generic map ( G_MAX => C_MAX ) -- Použije hodnotu z generic
        port map (
            CLK => CLK,
            RST => RST,
            ce  => ce_sample
        );

    -- Zvyšok logiky (p_debounce a priradenie výstupov) zostáva rovnaký ako predtým...
    p_debounce : process(CLK)
    begin
        if rising_edge(CLK) then
            if RST = '1' then
                sync0     <= (others => '0');
                sync1     <= (others => '0');
                debounced <= (others => '0');
                delayed   <= (others => '0');
                for i in 0 to 2 loop
                    shift_reg(i) <= (others => '0');
                end loop;
            else
                sync1 <= sync0;
                sync0 <= btns_in;

                if ce_sample = '1' then
                    for i in 0 to 2 loop
                        shift_reg(i) <= shift_reg(i)(C_SHIFT_LEN-2 downto 0) & sync1(i);
                        if shift_reg(i) = (shift_reg(i)'range => '1') then
                            debounced(i) <= '1';
                        elsif shift_reg(i) = (shift_reg(i)'range => '0') then
                            debounced(i) <= '0';
                        end if;
                    end loop;
                end if;
                delayed <= debounced;
            end if;
        end if;
    end process;

    BTNU_d <= debounced(2) and not(delayed(2));
    BTND_d <= debounced(1) and not(delayed(1));
    BTNC_d <= debounced(0) and not(delayed(0));

end Behavioral;
