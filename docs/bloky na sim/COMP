library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity COMP is
    port (
        CLK  : in  std_logic;
        RST  : in  std_logic;

        SW0  : in  std_logic;
        BTNC : in  std_logic;

        HT   : in  std_logic_vector(5 downto 0);
        MT   : in  std_logic_vector(5 downto 0);
        ST   : in  std_logic_vector(5 downto 0);

        HA   : in  std_logic_vector(5 downto 0);
        MA   : in  std_logic_vector(5 downto 0);
        SA   : in  std_logic_vector(5 downto 0);

        STAV : out std_logic_vector(3 downto 0);
        LED  : out std_logic;
        BUZZ : out std_logic
    );
end entity COMP;

architecture Behavioral of COMP is

    constant C_15S : unsigned(30 downto 0) := to_unsigned(1_500_000_000 - 1, 31);

    signal match_time    : std_logic := '0';
    signal alarm_active  : std_logic := '0';
    signal snooze_active : std_logic := '0';
    signal snooze_cnt    : unsigned(30 downto 0) := (others => '0');

begin

    match_time <= '1' when (HT = HA and MT = MA and ST = SA) else '0';

    process(CLK)
    begin
        if rising_edge(CLK) then
            if RST = '1' then
                alarm_active  <= '0';
                snooze_active <= '0';
                snooze_cnt    <= (others => '0');

            else
                if SW0 = '0' then
                    alarm_active  <= '0';
                    snooze_active <= '0';
                    snooze_cnt    <= (others => '0');

                else
                    -- keď sa časy rovnajú, alarm sa aktivuje
                    if match_time = '1' then
                        alarm_active <= '1';
                    end if;

                    if (alarm_active = '1') and (BTNC = '1') then
                        snooze_active <= '1';
                        snooze_cnt    <= (others => '0');
                    end if;

                    -- odpočet 
                    if snooze_active = '1' then
                        if snooze_cnt = C_15S then
                            snooze_active <= '0';
                            snooze_cnt    <= (others => '0');
                        else
                            snooze_cnt <= snooze_cnt + 1;
                        end if;
                    end if;
                end if;
            end if;
        end if;
    end process;

    STAV <= "1011" when SW0 = '1' else "1111";

    LED  <= '1' when snooze_active = '1' else '0';

    BUZZ <= '1' when (alarm_active = '1' and snooze_active = '0' and SW0 = '1')
            else '0';

end architecture Behavioral;
