library ieee;
use ieee.std_logic_1164.all;

entity SET_A is
    port (
        BTNU   : in  std_logic;
        BTND   : in  std_logic;
        BTNC   : in  std_logic;
        SW1    : in  std_logic;
        SW2    : in  std_logic;

        BTNC_C : out std_logic;

        BTNU_H : out std_logic;
        BTND_H : out std_logic;
        BTNC_H : out std_logic;

        BTNU_A : out std_logic;
        BTND_A : out std_logic;
        BTNC_A : out std_logic
    );
end entity SET_A;

architecture Behavioral of SET_A is
begin

    process(BTNU, BTND, BTNC, SW1, SW2)
    begin
        -- defaultne všetko vypnuté
        BTNC_C <= '0';

        BTNU_H <= '0';
        BTND_H <= '0';
        BTNC_H <= '0';

        BTNU_A <= '0';
        BTND_A <= '0';
        BTNC_A <= '0';

        if (SW1 = '0' and SW2 = '0') then
            -- režim C
            BTNC_C <= BTNC;

        elsif (SW1 = '1' and SW2 = '0') then
            -- režim A
            BTNU_A <= BTNU;
            BTND_A <= BTND;
            BTNC_A <= BTNC;

        elsif (SW1 = '0' and SW2 = '1') then
            -- režim H
            BTNU_H <= BTNU;
            BTND_H <= BTND;
            BTNC_H <= BTNC;

        else
            -- režim 11 -> nič
            null;
        end if;
    end process;

end architecture Behavioral;
