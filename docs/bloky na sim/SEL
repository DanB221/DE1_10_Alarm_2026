library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity SEL is
    port (
        CLK    : in  std_logic;
        RST    : in  std_logic;

        digit0 : in  std_logic_vector(3 downto 0);
        digit1 : in  std_logic_vector(3 downto 0);
        digit2 : in  std_logic_vector(3 downto 0);
        digit3 : in  std_logic_vector(3 downto 0);
        digit4 : in  std_logic_vector(3 downto 0);
        digit5 : in  std_logic_vector(3 downto 0);
        digit6 : in  std_logic_vector(3 downto 0);
        digit7 : in  std_logic_vector(3 downto 0);

        seg    : out std_logic_vector(3 downto 0);
        an_seg : out std_logic_vector(7 downto 0)
    );
end entity SEL;

architecture Behavioral of SEL is

    signal refresh_cnt : unsigned(16 downto 0) := (others => '0');
    signal digit_sel   : unsigned(2 downto 0)  := (others => '0');

begin

    process(CLK)
    begin
        if rising_edge(CLK) then
            if RST = '1' then
                refresh_cnt <= (others => '0');
                digit_sel   <= (others => '0');
            else
                if refresh_cnt = 100000 - 1 then
                    refresh_cnt <= (others => '0');

                    if digit_sel = "111" then
                        digit_sel <= (others => '0');
                    else
                        digit_sel <= digit_sel + 1;
                    end if;
                else
                    refresh_cnt <= refresh_cnt + 1;
                end if;
            end if;
        end if;
    end process;

    process(digit_sel, digit0, digit1, digit2, digit3, digit4, digit5, digit6, digit7)
    begin
        seg    <= "0000";
        an_seg <= "11111111";

        case digit_sel is
            when "000" =>
                seg    <= digit0;
                an_seg <= "01111111";

            when "001" =>
                seg    <= digit1;
                an_seg <= "10111111";

            when "010" =>
                seg    <= digit2;
                an_seg <= "11011111";

            when "011" =>
                seg    <= digit3;
                an_seg <= "11101111";

            when "100" =>
                seg    <= digit4;
                an_seg <= "11110111";

            when "101" =>
                seg    <= digit5;
                an_seg <= "11111011";

            when "110" =>
                seg    <= digit6;
                an_seg <= "11111101";

            when "111" =>
                seg    <= digit7;
                an_seg <= "11111110";

            when others =>
                seg    <= "0000";
                an_seg <= "11111111";
        end case;
    end process;

end architecture Behavioral;
